// Variáveis configuráveis na aba de variáveis de instância no editor de salas do GameMaker
door_id = "default"; // Associa este botão à porta com o mesmo door_id
activation_time = 180; // Duração ativo em frames (3 segundos). Use -1 para infinito/permanente

// Variáveis de controle de estado
is_active = false;
timer = 0;
